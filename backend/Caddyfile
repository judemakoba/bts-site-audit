{
    admin off
    auto_https off
    http_port 8080
}

:8080 {
    # Strip all default Caddy security headers (including CSP which blocks inline onclick handlers)
    header {
        -Content-Security-Policy
        -Permissions-Policy
        -X-Content-Type-Options
        -X-Frame-Options
        -Referrer-Policy
        -X-XSS-Protection
    }
    reverse_proxy 127.0.0.1:3000
}
